# 검색 엔진에 노출할 운영 서비스 주소 (예: https://your-site.example)
# SITE_URL=

# 공공데이터포털(data.go.kr) 인증키 — 마이페이지 > 데이터활용 > Open API > 개인 API인증키 의 "Decoding" 값
DATA_GO_KR_SERVICE_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://cpzbsggltgenwktwenkf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 적재 스크립트(scripts/load-benefits.mjs) 전용 — 서버/로컬에서만 사용
SUPABASE_SECRET_KEY=

# 배포 환경의 서비스 origin. next dev에서는 생략 시 http://localhost:3000
# AUTH_SITE_URL=https://your-site.example

# 회원 탈퇴 재인증 전용. 카카오 로그인과 같은 REST API 키와 클라이언트 시크릿을 사용한다.
# KAKAO_REAUTH_CLIENT_ID=
# KAKAO_REAUTH_CLIENT_SECRET=
# 탈퇴 접수와 처리 상태 조회에 사용하는 서버 전용 Supabase secret key.
# SUPABASE_WITHDRAWAL_SECRET_KEY=

# 선택. PDF 작업 서버에서 영속 저장소 경로를 지정한다.
# MYHOME_DATA_DIR=.cache/myhome
# MYHOME_PYTHON=python3
# MYHOME_PARSE_LIMIT=10
